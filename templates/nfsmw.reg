"CD Drive"="Z:\\data\\Jk4Speed\\NFSMW"
"FirstTime"=dword:00000001
"SwapSize"="73400320"
"Language"="English US"
"g_RacingResolution"=dword:00000003
"g_VSyncOn"=dword:00000001
"g_FSAALevel"=dword:00000000
